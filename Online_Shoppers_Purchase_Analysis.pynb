   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    random_state=42,\n",
    "    stratify=y\n",
    ")\n",
    "\n",
    "print(\"Training features shape:\", X_train.shape)\n",
    "print(\"Testing features shape:\", X_test.shape)\n",
    "\n",
    "print(\"\\nTraining target distribution:\")\n",
    "print(y_train.value_counts())\n",
    "\n",
    "print(\"\\nTesting target distribution:\")\n",
    "print(y_test.value_counts())\n",
    "\n",
    "print(\"\\nTraining target percentage:\")\n",
    "print(y_train.value_counts(normalize=True) * 100)\n",
    "\n",
    "print(\"\\nTesting target percentage:\")\n",
    "print(y_test.value_counts(normalize=True) * 100)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cebfb3a5-8c51-40b5-9cb7-42b30f5d2927",
   "metadata": {},
   "source": [
    "### Build the preprocessing pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "4fc88842-3943-490d-912f-5de778e6f0b6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Preprocessing pipeline created successfully!\n"
     ]
    }
   ],
   "source": [
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
    "\n",
    "# Numerical feature preprocessing\n",
    "numeric_transformer = StandardScaler()\n",
    "\n",
    "# Categorical feature preprocessing\n",
    "categorical_transformer = OneHotEncoder(\n",
    "    handle_unknown=\"ignore\"\n",
    ")\n",
    "\n",
    "# Combine both preprocessing steps\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\"num\", numeric_transformer, numeric_features),\n",
    "        (\"cat\", categorical_transformer, categorical_features)\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\"Preprocessing pipeline created successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5e26fb49-38e5-4806-ab66-1bb63317cc77",
   "metadata": {},
   "source": [
    "### Define the five ML models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "95ca84e1-8eb8-4efd-80e3-4f856defa04c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Updated preprocessing pipeline created successfully!\n"
     ]
    }
   ],
   "source": [
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
    "\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\"num\", StandardScaler(), numeric_features),\n",
    "        (\"cat\", OneHotEncoder(\n",
    "            handle_unknown=\"ignore\",\n",
    "            sparse_output=False\n",
    "        ), categorical_features)\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\"Updated preprocessing pipeline created successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "450031f8-6762-4680-827a-bf323dac4c9e",
   "metadata": {},
   "source": [
    "### Create the five model pipelines"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "1b420161-2e4e-4692-9350-d2dfd3950087",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Five model pipelines created successfully!\n",
      "- Logistic Regression\n",
      "- Decision Tree\n",
      "- KNN\n",
      "- Gaussian Naive Bayes\n",
      "- SVM\n"
     ]
    }
   ],
   "source": [
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.naive_bayes import GaussianNB\n",
    "from sklearn.svm import SVC\n",
    "\n",
    "# Define the five models\n",
    "models = {\n",
    "    \"Logistic Regression\": LogisticRegression(\n",
    "        max_iter=2000,\n",
    "        random_state=42\n",
    "    ),\n",
    "\n",
    "    \"Decision Tree\": DecisionTreeClassifier(\n",
    "        random_state=42\n",
    "    ),\n",
    "\n",
    "    \"KNN\": KNeighborsClassifier(\n",
    "        n_neighbors=5\n",
    "    ),\n",
    "\n",
    "    \"Gaussian Naive Bayes\": GaussianNB(),\n",
    "\n",
    "    \"SVM\": SVC(\n",
    "        probability=True,\n",
    "        random_state=42\n",
    "    )\n",
    "}\n",
    "\n",
    "# Create a separate preprocessing + model pipeline for each model\n",
    "model_pipelines = {}\n",
    "\n",
    "for model_name, model in models.items():\n",
    "    model_pipelines[model_name] = Pipeline(\n",
    "        steps=[\n",
    "            (\"preprocessor\", preprocessor),\n",
    "            (\"classifier\", model)\n",
    "        ]\n",
    "    )\n",
    "\n",
    "print(\"Five model pipelines created successfully!\")\n",
    "\n",
    "for model_name in model_pipelines:\n",
    "    print(\"-\", model_name)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f416c363-412c-4fc6-82f4-c40757f733ca",
   "metadata": {},
   "source": [
    "### Train the five models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "1411941f-9b98-47da-96b8-b971426e4658",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SVM trained successfully!\n",
      "Training time: 2.71 seconds\n",
      "\n",
      "Probability predictions shape: (2441, 2)\n",
      "\n",
      "First 5 probability predictions:\n",
      "[[0.93729354 0.06270646]\n",
      " [0.92595893 0.07404107]\n",
      " [0.94897331 0.05102669]\n",
      " [0.94154749 0.05845251]\n",
      " [0.92942484 0.07057516]]\n",
      "\n",
      "SVM probability calibration completed successfully!\n"
     ]
    }
   ],
   "source": [
    "# SVM model with probability calibration (scikit-learn 1.9 compatible)\n",
    "\n",
    "import time\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.calibration import CalibratedClassifierCV\n",
    "from sklearn.pipeline import Pipeline\n",
    "\n",
    "# Step 1: Create calibrated SVM model\n",
    "models[\"SVM\"] = CalibratedClassifierCV(\n",
    "    estimator=SVC(random_state=42),\n",
    "    method=\"sigmoid\",\n",
    "    cv=3\n",
    ")\n",
    "\n",
    "# Step 2: Create SVM preprocessing pipeline\n",
    "model_pipelines[\"SVM\"] = Pipeline(\n",
    "    steps=[\n",
    "        (\"preprocessor\", preprocessor),\n",
    "        (\"classifier\", models[\"SVM\"])\n",
    "    ]\n",
    ")\n",
    "\n",
    "# Step 3: Train SVM\n",
    "start_time = time.time()\n",
    "\n",
    "model_pipelines[\"SVM\"].fit(X_train, y_train)\n",
    "\n",
    "training_times[\"SVM\"] = time.time() - start_time\n",
    "\n",
    "# Step 4: Generate probability predictions\n",
    "svm_probabilities = model_pipelines[\"SVM\"].predict_proba(X_test)\n",
    "\n",
    "# Step 5: Verify results\n",
    "print(\"SVM trained successfully!\")\n",
    "print(f\"Training time: {training_times['SVM']:.2f} seconds\")\n",
    "\n",
    "print(\"\\nProbability predictions shape:\", svm_probabilities.shape)\n",
    "\n",
    "print(\"\\nFirst 5 probability predictions:\")\n",
    "print(svm_probabilities[:5])\n",
    "\n",
    "print(\"\\nSVM probability calibration completed successfully!\")"
   ]
  },
