    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "# Set model names\n",
    "model_names = results_df[\"Model\"]\n",
    "\n",
    "# Graph 1: Accuracy comparison\n",
    "plt.figure(figsize=(9, 5))\n",
    "\n",
    "plt.bar(model_names, results_df[\"Accuracy\"])\n",
    "\n",
    "plt.title(\"Model Accuracy Comparison\")\n",
    "plt.xlabel(\"Machine Learning Models\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.xticks(rotation=25)\n",
    "plt.ylim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# Graph 2: Precision, Recall and F1-score\n",
    "results_df.set_index(\"Model\")[\n",
    "    [\"Precision\", \"Recall\", \"F1-Score\"]\n",
    "].plot(\n",
    "    kind=\"bar\",\n",
    "    figsize=(10, 5)\n",
    ")\n",
    "\n",
    "plt.title(\"Precision, Recall and F1-Score Comparison\")\n",
    "plt.xlabel(\"Machine Learning Models\")\n",
    "plt.ylabel(\"Score\")\n",
    "plt.xticks(rotation=25)\n",
    "plt.ylim(0, 1)\n",
    "plt.legend(loc=\"best\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# Graph 3: ROC Curve comparison\n",
    "from sklearn.metrics import roc_curve, auc\n",
    "\n",
    "plt.figure(figsize=(9, 6))\n",
    "\n",
    "for model_name, pipeline in model_pipelines.items():\n",
    "\n",
    "    y_prob = pipeline.predict_proba(X_test)[:, 1]\n",
    "\n",
    "    fpr, tpr, thresholds = roc_curve(y_test, y_prob)\n",
    "\n",
    "    roc_auc = auc(fpr, tpr)\n",
    "\n",
    "    plt.plot(\n",
    "        fpr,\n",
    "        tpr,\n",
    "        label=f\"{model_name} (AUC = {roc_auc:.3f})\"\n",
    "    )\n",
    "\n",
    "plt.plot([0, 1], [0, 1], linestyle=\"--\", label=\"Random Classifier\")\n",
    "\n",
    "plt.title(\"ROC Curve Comparison\")\n",
    "plt.xlabel(\"False Positive Rate\")\n",
    "plt.ylabel(\"True Positive Rate\")\n",
    "plt.legend(loc=\"lower right\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cd98e7cd-9a65-4c91-8dce-06f0ebf07b8d",
   "metadata": {},
   "source": [
    "### Save all five trained models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "7a0c4862-3e61-411c-ae32-1147a09e822a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Logistic Regression saved successfully: model/logistic_regression.pkl\n",
      "Decision Tree saved successfully: model/decision_tree.pkl\n",
      "KNN saved successfully: model/knn.pkl\n",
      "Gaussian Naive Bayes saved successfully: model/gaussian_naive_bayes.pkl\n",
      "SVM saved successfully: model/svm.pkl\n",
      "\n",
      "All five trained models saved successfully!\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import joblib\n",
    "\n",
    "# Create model directory\n",
    "os.makedirs(\"model\", exist_ok=True)\n",
    "\n",
    "# Save all trained pipelines\n",
    "for model_name, pipeline in model_pipelines.items():\n",
    "\n",
    "    filename = (\n",
    "        model_name.lower()\n",
    "        .replace(\" \", \"_\")\n",
    "        + \".pkl\"\n",
    "    )\n",
    "\n",
    "    filepath = os.path.join(\"model\", filename)\n",
    "\n",
    "    joblib.dump(pipeline, filepath)\n",
    "\n",
    "    print(f\"{model_name} saved successfully: {filepath}\")\n",
    "\n",
    "print(\"\\nAll five trained models saved successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c1f6ad49-a040-4b27-9a96-5fb16108e7e0",
   "metadata": {},
   "source": [
    "### Verify saved model files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "58cca825-d30b-47a1-8d49-1be7c6dcbb31",
   "metadata": {},
   "outputs": [
    {
