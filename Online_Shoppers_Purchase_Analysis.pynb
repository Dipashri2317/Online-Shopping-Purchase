  {
   "cell_type": "markdown",
   "id": "00a018e0-79ad-4de9-92db-6bd6d63b529f",
   "metadata": {},
   "source": [
    "### Check duplicate-label consistency"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "cd362b73-1cad-4df7-a5c9-f015873cd344",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Rows involved in duplicates: 201\n",
      "Duplicate feature groups with conflicting targets: 0\n"
     ]
    }
   ],
   "source": [
    "feature_columns = df.columns.drop(\"Revenue\")\n",
    "\n",
    "duplicate_rows = df[df.duplicated(keep=False)]\n",
    "\n",
    "duplicate_target_check = (\n",
    "    duplicate_rows.groupby(list(feature_columns))[\"Revenue\"]\n",
    "    .nunique()\n",
    ")\n",
    "\n",
    "print(\"Rows involved in duplicates:\", len(duplicate_rows))\n",
    "print(\n",
    "    \"Duplicate feature groups with conflicting targets:\",\n",
    "    (duplicate_target_check > 1).sum()\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "527a317e-bf94-4dcc-aa35-926ee0a47810",
   "metadata": {},
   "source": [
    "### Remove duplicate rows"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "0c785cf9-7a6b-46b3-84c6-dd36b1b85c97",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Before removing duplicates: (12330, 18)\n",
      "After removing duplicates: (12205, 18)\n",
      "Remaining duplicate rows: 0\n"
     ]
    }
   ],
   "source": [
    "# Check dataset size before removing duplicates\n",
    "print(\"Before removing duplicates:\", df.shape)\n",
    "\n",
    "# Remove exact duplicate rows\n",
    "df = df.drop_duplicates().copy()\n",
    "\n",
    "# Check dataset size after removing duplicates\n",
    "print(\"After removing duplicates:\", df.shape)\n",
    "\n",
    "# Verify that no exact duplicates remain\n",
    "print(\"Remaining duplicate rows:\", df.duplicated().sum())"
   ]
  },
